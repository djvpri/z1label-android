<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Isi aplikasi (utama) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Login ===== -->
        <LinearLayout
            android:id="@+id/loginView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Z1 Label"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/z1_primary" />

            <EditText
                android:id="@+id/txtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Email Z1 Pos"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/txtSandi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Password"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/txtUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Server: https://z1pos.zomet.my.id"
                android:textSize="12sp"
                android:textColor="#888" />

            <Button
                style="@style/BtnRun"
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Masuk" />

            <TextView
                android:id="@+id/lblLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ===== Layar produk (utama) ===== -->
        <LinearLayout
            android:id="@+id/mainView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Top App Bar (teal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/z1_primary"
                android:orientation="vertical">

                <!-- Row: menu + title + printer chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <Button
                        android:id="@+id/btnMenu"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:text="☰"
                        android:textColor="@color/z1_on_primary"
                        android:textSize="22sp"
                        android:minWidth="0dp"
                        android:padding="0dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Produk"
                        android:textColor="@color/z1_on_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Printer chip -->
                    <LinearLayout
                        android:id="@+id/printerChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/printer_chip_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <View
                            android:id="@+id/printerDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/printer_dot_on" />

                        <TextView
                            android:id="@+id/printerChipName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="—"
                            android:textColor="@color/z1_on_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:maxWidth="140dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Search bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/search_bg"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/txtCari"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:hint="Cari produk / barcode..."
                        android:inputType="text"
                        android:background="@android:color/transparent"
                        android:textSize="15sp"
                        android:imeOptions="actionSearch" />
                </LinearLayout>
            </LinearLayout>

            <!-- Printer status banner -->
            <LinearLayout
                android:id="@+id/printerBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/z1_banner_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖨️"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/printerBannerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Printer belum dipilih"
                    android:textColor="@color/z1_banner_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Product list + FAB overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listProduk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/z1_surface"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp"
                    android:clipToPadding="false" />

                <!-- FAB Tambah -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabTambah"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@android:drawable/ic_input_add"
                    app:backgroundTint="@color/z1_primary"
                    app:tint="@color/z1_on_primary"
                    android:contentDescription="Tambah Produk"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Hidden buttons — IDs dipertahankan untuk ActivityMainBinding -->
            <Button
                style="@style/BtnRun"
                android:id="@+id/btnSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Urut" />
            <Button
                style="@style/BtnRun"
                android:id="@+id/btnPaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Kertas" />
            <Button
                style="@style/BtnRun"
                android:id="@+id/btnPrinter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Pilih Printer Bluetooth..." />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <Button
                    style="@style/BtnRun"
                    android:id="@+id/btnProto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TSPL Printer Label" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button
                        style="@style/BtnRun"
                        android:id="@+id/btnFont"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Font: S" />
                    <Button
                        style="@style/BtnRun"
                        android:id="@+id/btnBarcode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="1D/2D"
                        android:textSize="12sp"
                        android:minWidth="52dp" />
                    <Button
                        style="@style/BtnRun"
                        android:id="@+id/btnBcSrc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="6 digit"
                        android:textSize="12sp"
                        android:minWidth="52dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom action bar: Muat + Cetak -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/z1_surface"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↻ Muat"
                    android:textColor="@color/z1_primary"
                    android:background="?attr/selectableItemBackground"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btnCetak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="🖨️ Cetak"
                    android:textColor="@color/z1_on_primary"
                    android:background="@drawable/btn_cetak_bg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:enabled="false"
                    android:minHeight="48dp" />
            </LinearLayout>

            <!-- Hidden system buttons — IDs dipertahankan, aksi via drawer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <Button
                    style="@style/BtnRun"
                    android:id="@+id/btnTambah"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="＋ Tambah" />
                <Button
                    style="@style/BtnRun"
                    android:id="@+id/btnLogout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Keluar" />
                <Button
                    style="@style/BtnRun"
                    android:id="@+id/btnCekUpdate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Update" />
                <Button
                    style="@style/BtnRun"
                    android:id="@+id/btnKirimLog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Kirim Log" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:text=""
                android:textSize="13sp"
                android:textColor="@color/z1_on_surface_variant"
                android:background="@color/z1_surface" />

            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="2dp"
                android:text="Z1 Label"
                android:textSize="11sp"
                android:textColor="#888"
                android:background="@color/z1_surface" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Sidebar: pengaturan label tersier ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navDrawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/drawer_header"
        app:menu="@menu/menu_sidemenu" />

</androidx.drawerlayout.widget.DrawerLayout>
